# AI Data Platform — example environment configuration.
# Copy to .env for local development: cp .env.example .env
# .env is gitignored; never commit real credentials.
# Real environment variables override values from .env.

# --- Application settings (docs/configuration.md) ---------------------------

# Required: deployment environment. One of: development, production.
APP_ENVIRONMENT=development

# Optional: log level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO.
APP_LOG_LEVEL=INFO

# Optional: service name used in logs and telemetry. Default: ai-data-platform.
# APP_NAME=ai-data-platform

# Unknown APP_ variables are rejected at startup to surface typos.
# Service-specific variables are documented by the service that introduces them.

# --- Local infrastructure (docker-compose.yml, docs/local-development.md) ---
# These variables configure the Docker Compose stack itself, not application
# services, so they carry no APP_ prefix. All have working defaults; override
# only if the defaults collide with ports or credentials on your machine.

# Host ports for Kafka, MinIO API, MinIO Console, PostgreSQL.
# KAFKA_HOST_PORT=9092
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# POSTGRES_HOST_PORT=5432

# MinIO root credentials for the local object store.
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin-local

# PostgreSQL superuser credentials and initial database for the local instance.
# POSTGRES_USER=platform
# POSTGRES_PASSWORD=platform-local
# POSTGRES_DB=platform

# Name of the shared Docker network (rarely changed).
# PLATFORM_NETWORK_NAME=ai-data-platform
