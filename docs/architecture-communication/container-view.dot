// Контейнерный вид — AI Data Platform
// Формат: Graphviz DOT | rankdir=TB | Qoder Canvas совместимый
// Обновлено: 2026-09-18 (Milestone 0-6 реализованы, TASK-001–TASK-062)
//
// Легенда:
//   [прямоугольник]        — сервис / контейнер
//   {ромб}                 — Kafka-топик
//   [(цилиндр)]            — хранилище данных
//   ((круг))               — внешний источник
//   Сплошная линия         — реализовано (TASK-001–TASK-062)
//   Пунктирная линия       — проектное состояние (Milestone 7+, не реализовано)

digraph "AI Data Platform — Контейнерный вид" {
    rankdir=TB
    fontname="Helvetica"
    node [fontname="Helvetica", fontsize=11, style=filled]
    edge [fontname="Helvetica", fontsize=9]
    label="AI Data Platform — Контейнерный вид\nРеализовано (M0–M6) / Проектное состояние (M7+)"
    labelloc=t
    fontsize=14

    // === Внешние источники ===
    subgraph cluster_sources {
        label="Внешние источники данных (5 адаптеров)"
        style=dashed
        color=grey60
        node [shape=ellipse, fillcolor="#E8E8E8", color=grey50]

        src_fakestore  [label="Fake Store API"]
        src_bestbuy    [label="Best Buy API"]
        src_ebay       [label="eBay API\n(marketplace)"]
        src_retailer   [label="Web Retailer\n(HTML scrape)"]
        src_difficult  [label="Difficult Retailer\n(anti-bot)"]
    }

    // === Граница платформы ===
    subgraph cluster_platform {
        label="AI Data Platform — граница системы"
        style=bold
        color=navy
        fontcolor=navy
        fontsize=12

        // --- Ingestion ---
        subgraph cluster_ingestion {
            label="Ingestion (Source Adapters)"
            style=rounded
            fillcolor="#E3F2FD"
            color="#1565C0"

            ingestion [label="Ingestion Service\n— 5 source adapters\n— canonical event emit\n— continuous fetch loop", shape=box, fillcolor="#BBDEFB"]
        }

        // --- Kafka ---
        subgraph cluster_kafka {
            label="Apache Kafka (KRaft, single-node)"
            style=rounded
            fillcolor="#FFF3E0"
            color="#E65100"

            node [shape=component, fillcolor="#FFE0B2"]

            topic_raw       [label="products.raw.v1\n(3 partitions, 7d)"]
            topic_validated [label="products.validated.v1\n(3 partitions, 7d)"]
            topic_invalid   [label="products.invalid.v1\n(DLQ, 7d)"]
            topic_pipeline  [label="pipeline.events.v1\n(1 partition, 3d)"]
            topic_dq        [label="data-quality.events.v1\n(1 partition, 3d)"]
        }

        // --- Processing ---
        subgraph cluster_processing {
            label="Processing Pipeline"
            style=rounded
            fillcolor="#E8F5E9"
            color="#2E7D32"

            processor [label="Processor\n— Pydantic validation\n— schema normalization\n— deduplication\n— Polars transforms", shape=box, fillcolor="#C8E6C9"]
        }

        // --- Data Lake ---
        subgraph cluster_lake {
            label="Data Lake (Medallion — MinIO/S3)"
            style=rounded
            fillcolor="#F3E5F5"
            color="#6A1B9A"

            node [shape=cylinder]

            bronze [label="Bronze\nRaw Parquet\n(deterministic keys)", fillcolor="#E1BEE7"]
            silver [label="Silver\nValidated Parquet\n(normalized, deduplicated)", fillcolor="#CE93D8"]
            gold   [label="Gold\n(PostgreSQL analytical\ntables: daily_metrics,\nquality_results,\nhealth_results)", fillcolor="#BA68C8"]
        }

        // --- Storage Services ---
        subgraph cluster_writers {
            label="Lake Services"
            style=rounded
            fillcolor="#FCE4EC"
            color="#880E4F"

            raw_writer   [label="Raw Writer\n(Bronze owner)", shape=box, fillcolor="#F8BBD0"]
            lake_writer  [label="Lake Writer\n(Silver owner)", shape=box, fillcolor="#F48FB1"]
        }

        // --- Orchestration & Warehouse ---
        subgraph cluster_warehouse {
            label="Warehouse & Orchestration"
            style=rounded
            fillcolor="#E0F7FA"
            color="#00695C"

            airflow  [label="Apache Airflow 2.10\n— ingestion_health (15min)\n— daily_data_quality (daily)\n— parquet_compaction (6h)\n— build_daily_metrics (daily)", shape=box, fillcolor="#B2EBF2"]
            wh_loader [label="Warehouse Loader\n(Silver → PostgreSQL,\nidempotent UPSERT\nпо event_id)", shape=box, fillcolor="#80DEEA"]
            pg       [label="PostgreSQL 17\n(8 tables, 6 migrations\nAlembic)", shape=cylinder, fillcolor="#4DD0E1"]
        }

        // --- Serving ---
        subgraph cluster_serving {
            label="Serving Layer"
            style=rounded
            fillcolor="#FFF9C4"
            color="#F57F17"

            api    [label="FastAPI\n(products, analytics,\npipeline, DQ)", shape=box, fillcolor="#FFF59D", style=dashed, color=grey50]
            agent  [label="LangGraph Agent\n(read-only SQL,\ncontrolled tools)", shape=box, fillcolor="#FFF176", style=dashed, color=grey50]
        }
    }

    // === Observability ===
    subgraph cluster_observability {
        label="Observability (M10)"
        style=dashed
        color=grey50
        node [shape=box, fillcolor="#F5F5F5", color=grey50, style=dashed]

        prometheus [label="Prometheus"]
        grafana    [label="Grafana"]
        otel       [label="OpenTelemetry"]
    }

    // === Рёбра: внешние источники → ingestion ===
    src_fakestore -> ingestion [label="REST"]
    src_bestbuy   -> ingestion [label="REST + API key"]
    src_ebay      -> ingestion [label="OAuth + normalizer"]
    src_retailer  -> ingestion [label="HTTP/HTML parse"]
    src_difficult -> ingestion [label="anti-bot / rate limit"]

    // === Ingestion → Kafka ===
    ingestion -> topic_raw [label="publish\nProductObservationEvent"]

    // === Kafka → Processing ===
    topic_raw -> processor [label="consume"]

    // === Processing → Kafka (validated / invalid) ===
    processor -> topic_validated [label="publish\nvalidated events"]
    processor -> topic_invalid   [label="publish\nfailed events (DLQ)"]

    // === Kafka → Writers ===
    topic_raw -> raw_writer [label="consume\n(own group)"]
    topic_validated -> lake_writer [label="consume\n(own group)"]

    // === Writers → Lake ===
    raw_writer -> bronze [label="write\nParquet (deterministic keys)"]
    lake_writer -> silver [label="write\nParquet (normalized)"]

    // === Airflow ===
    bronze -> airflow [label="compaction\n(merge small files)"]
    airflow -> bronze [label="rewrite\ncompacted Parquet"]
    pg -> airflow [label="read\n(quality, metrics, health)"]
    airflow -> gold [label="write\n(daily_metrics,\nquality_results,\nhealth_results)"]

    // === Warehouse ===
    silver -> wh_loader [label="read Parquet"]
    wh_loader -> pg [label="load\n(UPSERT / idempotent)"]

    // === Serving ===
    pg -> api [label="SQL\nqueries", style=dashed, color=grey50]
    pg -> agent [label="read-only\nSQL", style=dashed, color=grey50]
    api -> agent [label="tool\ncall", style=dashed, color=grey50]

    // === Observability (пунктир ко всем) ===
    processor  -> prometheus [style=dotted, color=grey70, label="metrics"]
    raw_writer -> prometheus [style=dotted, color=grey70]
    lake_writer -> prometheus [style=dotted, color=grey70]
    airflow    -> prometheus [style=dotted, color=grey70]
    ingestion  -> otel       [style=dotted, color=grey70, label="traces"]
}
