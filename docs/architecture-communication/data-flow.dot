// Поток данных — AI Data Platform (Medallion Architecture)
// Формат: Graphviz DOT | rankdir=LR | линейная топология потока
// Обновлено: 2026-09-25 (Milestone 0–13 реализованы, TASK-001–TASK-115)
//
// Показывает движение данных от источника до serving-слоя через
// медальон-озеро (Bronze → Silver → PostgreSQL → Gold analytical tables).

digraph "AI Data Platform — Поток данных" {
    rankdir=LR
    fontname="Helvetica"
    node [fontname="Helvetica", fontsize=11, style=filled]
    edge [fontname="Helvetica", fontsize=9]
    label="AI Data Platform — Поток данных (Medallion)\nОт внешнего источника до serving-слоя (M0–M13 реализовано)"
    labelloc=t
    fontsize=14

    // === Источники ===
    node [shape=ellipse, fillcolor="#E8E8E8", color=grey50]
    source [label="Внешние источники\n(5 адаптеров):\nFakeStore, BestBuy,\neBay, WebRetailer,\nDifficultRetailer"]

    // === Ingestion ===
    node [shape=box, fillcolor="#BBDEFB", color="#1565C0"]
    adapter [label="Source Adapter\n— REST/HTTP/HTML/anti-bot\n— emit ProductObservationEvent\n— partition key: source:external_id"]

    // === Kafka (raw) ===
    node [shape=component, fillcolor="#FFE0B2", color="#E65100"]
    kafka_raw [label="products.raw.v1"]

    // === Raw Writer + Bronze ===
    node [shape=box, fillcolor="#F8BBD0", color="#880E4F"]
    raw_writer [label="Raw Writer\n— consume raw events\n— Parquet serialize\n— MinIO upload"]

    node [shape=cylinder, fillcolor="#E1BEE7", color="#6A1B9A"]
    bronze [label="Bronze Layer\nRaw Parquet\n(deterministic object keys\nпо event_id)"]

    // === Processor ===
    node [shape=box, fillcolor="#C8E6C9", color="#2E7D32"]
    processor [label="Processor\n— Pydantic validation\n— schema normalization\n— deduplication\n— Polars transform"]

    // === Kafka (validated / DLQ) ===
    node [shape=component, fillcolor="#FFE0B2", color="#E65100"]
    kafka_valid [label="products.validated.v1"]
    kafka_dlq   [label="products.invalid.v1\n(DLQ)"]

    // === Lake Writer + Silver ===
    node [shape=box, fillcolor="#F48FB1", color="#880E4F"]
    lake_writer [label="Lake Writer\n— consume validated\n— Parquet serialize\n— MinIO upload"]

    node [shape=cylinder, fillcolor="#CE93D8", color="#6A1B9A"]
    silver [label="Silver Layer\nValidated Parquet\n(normalized, deduplicated)"]

    // === Warehouse Loader + PostgreSQL ===
    node [shape=box, fillcolor="#80DEEA", color="#00695C"]
    wh_loader [label="Warehouse Loader\n(idempotent UPSERT\nпо event_id,\nSilver Parquet → PG,\nperiodic 300s loop)"]

    node [shape=cylinder, fillcolor="#4DD0E1", color="#00695C"]
    pg [label="PostgreSQL\n(8 tables)\n— product_observations\n— sources, products\n— pipeline_runs\n— data_quality_results\n— ingestion_health_results\n— daily_metrics"]

    // === Airflow DAGs ===
    node [shape=box, fillcolor="#B2EBF2", color="#00695C"]
    airflow_quality    [label="DAG: daily_data_quality\n(4 checks: required_fields,\nprice_validity, freshness,\nduplicates)"]
    airflow_metrics    [label="DAG: build_daily_metrics\n(per-source daily aggregates,\navg_price, unique_products)"]
    airflow_health     [label="DAG: ingestion_health\n(source freshness,\ndegradation detection,\n15min schedule)"]
    airflow_compaction [label="DAG: parquet_compaction\n(merge small Parquet files,\n6h schedule)"]

    // === Gold (PostgreSQL analytical tables) ===
    node [shape=cylinder, fillcolor="#BA68C8", color="#6A1B9A"]
    gold_quality [label="Gold: data_quality_results\n(check results, pass/fail,\nrecords checked)"]
    gold_metrics [label="Gold: daily_metrics\n(analytical aggregates,\nper date/dimension)"]
    gold_health   [label="Gold: ingestion_health_results\n(source state, freshness,\ndegradation reasons)"]

    // === Serving ===
    node [shape=box, fillcolor="#FFF59D", color="#F57F17"]
    api [label="FastAPI\n(13+ endpoints,\n/metrics)"]
    agent [label="LangGraph Agent\n(read-only SQL,\n4 tools, in-process)"]

    // === Аналитические запросы ===
    node [shape=box, fillcolor="#E0E0E0", color=grey50]
    analytics [label="warehouse/analytics\nCTE, window functions,\nrolling averages,\nprice change detection"]

    // === Поток данных: Ingestion path ===
    source    -> adapter     [label="collect\n(5 adapters)"]
    adapter   -> kafka_raw   [label="publish"]
    kafka_raw -> raw_writer  [label="consume\n(group: raw-writer)"]
    raw_writer -> bronze     [label="write .parquet"]

    // === Поток данных: Processing path ===
    kafka_raw -> processor   [label="consume\n(group: processor)"]
    processor -> kafka_valid [label="validated"]
    processor -> kafka_dlq   [label="failed\n+ diagnostic context"]

    // === Поток данных: Silver path ===
    kafka_valid -> lake_writer [label="consume\n(group: lake-writer)"]
    lake_writer -> silver      [label="write .parquet"]

    // === Поток данных: Warehouse loading ===
    silver -> wh_loader [label="read Parquet\n(LakeReader, Silver filter)"]
    wh_loader -> pg     [label="UPSERT\n(idempotent by event_id)"]

    // === Поток данных: Airflow DAGs ===
    pg -> airflow_quality [label="read\nproduct_observations"]
    airflow_quality -> gold_quality [label="write\ncheck results"]

    pg -> airflow_metrics [label="read\nproduct_observations"]
    airflow_metrics -> gold_metrics [label="write\ndaily aggregates"]

    pg -> airflow_health [label="read\nsources, observations"]
    airflow_health -> gold_health [label="write\nhealth state"]

    bronze -> airflow_compaction [label="read\nsmall files"]
    airflow_compaction -> bronze [label="rewrite\ncompacted Parquet"]

    // === Поток данных: Serving ===
    pg -> analytics [label="SQL queries"]
    pg -> api   [label="SQL"]
    pg -> agent [label="read-only SQL"]
    api -> agent [label="tool call\n(in-process)"]

    // === Ранги для линейного layout ===
    { rank=same; source }
    { rank=same; adapter; kafka_raw }
    { rank=same; raw_writer; processor }
    { rank=same; bronze; kafka_valid; kafka_dlq }
    { rank=same; lake_writer; silver }
    { rank=same; wh_loader; airflow_compaction }
    { rank=same; pg }
    { rank=same; airflow_quality; airflow_metrics; airflow_health }
    { rank=same; gold_quality; gold_metrics; gold_health }
    { rank=same; analytics; api; agent }
}
